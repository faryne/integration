# faryne.dev nginx baseline
#
# Assumptions from this repository:
# - Go/Fiber backend listens on 127.0.0.1:8080 by default.
# - Frontend builds with VITE_API_BASE=https://faryne.dev/api-integration.
# - /api-integration/* should proxy to the backend with the prefix stripped.
# - /sns/* and /mcp are backend-rendered/API endpoints.
# - If frontend is served by nginx, the Vite build output is under
#   /var/www/faryne.dev/dist.
#
# Before reloading:
#   sudo nginx -t
#   sudo systemctl reload nginx

upstream faryne_api {
    server 127.0.0.1:33333;
}

# 藏掉 Server response header 裡的版本號（例如 nginx/1.24.0 -> nginx），減少對外洩漏版本資訊。
server_tokens off;

# LINE 的連結預覽爬蟲 UA 是 "facebookexternalhit/1.1;line-poker/1.0"，前面的 facebookexternalhit 就會命中。
# 不能寫成不分大小寫的 LINE：LINE App 內建瀏覽器的真人 UA 帶 "Line/13.x"，會被當成爬蟲拿到 meta HTML，
# 頁面裡的 location.replace 導回同一個網址又被當成爬蟲，變成無限迴圈。
map $http_user_agent $is_social_bot {
    default 0;
    ~*(facebookexternalhit|Facebot|Twitterbot|Slackbot|Discordbot|line-poker|TelegramBot|LinkedInBot) 1;
}

# 爬蟲抓 og:image 等靜態檔時不能也被轉去 meta HTML（不然預設圖拿到的是 HTML，預覽卡破圖），
# 只有「爬蟲而且不是靜態檔」才交給後端 /sns 渲染。map 的 regex 依出現順序比對、先中先贏。
map "$is_social_bot:$uri" $sns_render {
    default 0;
    "~^1:.*\.(?:jpe?g|png|gif|webp|svg|ico|css|js|txt|xml|json|webmanifest)$" 0;
    "~^1:" 1;
}

server {
    listen 80;
    listen [::]:80;
    server_name faryne.dev www.faryne.dev neko.maid.tw steamloom.works www.steamloom.works;

    # Enable this redirect after HTTPS certificates are ready.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name faryne.dev www.faryne.dev beta.faryne.dev;

    ssl_certificate /etc/letsencrypt/live/neko.maid.tw/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/neko.maid.tw/privkey.pem;

    client_max_body_size 1024m;

    root /var/www/faryne.dev/dist;
    index index.html;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    location /hololive.json {
        alias /var/www/html/public/hololive.json;
    }

    location /api-integration/ {
        proxy_pass http://faryne_api/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 30s;
        # AAS（agentic 多輪 tool-calling）單一步驟逾時已經拉到 180s
        # （service/storyteller/ai_provider.go 的 aiProviderAgenticTimeout），
        # 最多到 8 步，累加起來可能遠超過舊的 300s，這裡跟著放寬到 600s，
        # 避免 Go 那邊還在正常跑、卻先被 nginx 這層掐斷連線。
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;

        # 後端掛掉時，讓錯誤回應也帶 CORS header，且格式比照 service/output.CommonOutput，
        # 前端不用為了這種情況多寫一套解析邏輯。放在具名 location 是因為它是 nginx 自己產生
        # 回應（不會有 upstream 的 header 混進來），才不會跟正常回應的 Access-Control-Allow-Origin
        # 重複衝突。502/503/504 各自對應不同成因（連不上／服務端明確拒絕／逾時），分開給訊息。
        error_page 502 = @api_gateway_down_502;
        error_page 503 = @api_gateway_down_503;
        error_page 504 = @api_gateway_down_504;
    }

    location @api_gateway_down_502 {
        default_type application/json;
        add_header 'Access-Control-Allow-Origin' '*' always;
        return 502 '{"code":502,"cost_time":0,"data":null,"custom_code":"502000","uri":"$request_uri","method":"$request_method","message":"後端服務目前無法連線，請稍後再試"}';
    }

    location @api_gateway_down_503 {
        default_type application/json;
        add_header 'Access-Control-Allow-Origin' '*' always;
        return 503 '{"code":503,"cost_time":0,"data":null,"custom_code":"503000","uri":"$request_uri","method":"$request_method","message":"服務暫時維護中，請稍後再試"}';
    }

    location @api_gateway_down_504 {
        default_type application/json;
        add_header 'Access-Control-Allow-Origin' '*' always;
        return 504 '{"code":504,"cost_time":0,"data":null,"custom_code":"504000","uri":"$request_uri","method":"$request_method","message":"後端服務回應逾時，請稍後再試"}';
    }

    # SNS / OG meta routes are rendered by the backend.
    location @faryne_sns {
        rewrite ^(.*)$ /sns$request_uri break;
        proxy_pass http://faryne_api;
        proxy_set_header Host faryne.dev;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # React/Vite SPA fallback.
    location / {
        error_page 418 = @faryne_sns;

        if ($sns_render) {
            return 418;
        }

        proxy_pass https://beta.faryne.dev;
        proxy_ssl_server_name on;
        proxy_ssl_name beta.faryne.dev;
        proxy_set_header Host beta.faryne.dev;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name neko.maid.tw;

    ssl_certificate /etc/letsencrypt/live/neko.maid.tw/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/neko.maid.tw/privkey.pem;

    location ~ (retrieve\.json|search\.rss) {
        rewrite ^/(.*)$ /nekomaid/$1 break;
        proxy_pass http://faryne_api;
        proxy_set_header Host faryne.dev;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location @nekomaid_sns {
        rewrite ^(.*)$ /sns/nekomaid$request_uri break;
        proxy_pass http://faryne_api;
        proxy_set_header Host faryne.dev;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        error_page 418 = @nekomaid_sns;

        if ($sns_render) {
            return 418;
        }

        proxy_pass https://nekomaid.web.app;
        proxy_ssl_server_name on;
        proxy_ssl_name nekomaid.web.app;
        proxy_set_header Host nekomaid.web.app;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name steamloom.works www.steamloom.works;

    ssl_certificate /etc/letsencrypt/live/steamloom.works/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/steamloom.works/privkey.pem;

    client_max_body_size 1024m;

    # SteamLoom 前端只走同源 /api；結尾的斜線會在 proxy_pass 時移除 /api 前綴，
    # 例如 /api/storyteller/projects 轉成後端的 /storyteller/projects。
    location /api/ {
        proxy_pass http://faryne_api/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    # SteamLoom 是獨立站，故事頁面在這個網域是直接掛在根路徑（沒有 /storyteller 前綴）；
    # 這裡補上 /storyteller 前綴轉給後端，才會對到 service/sns/meta.go 裡 pathCollection
    # 的 regex（跟 @nekomaid_sns 補 /nekomaid 前綴是同一個道理）。後端會依 X-Forwarded-Host
    # 判斷是 steamloom.works，自己組出不含 /storyteller 前綴、指向這個網域的 canonical/OG url。
    location @steamloom_sns {
        rewrite ^(.*)$ /sns/storyteller$request_uri break;
        proxy_pass http://faryne_api;
        proxy_set_header Host faryne.dev;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # OAuth authorization server 的公開端點（metadata、DCR、token、revoke），路徑原樣轉給後端
    # route.StorytellerOAuth；/oauth/authorize 是前端 SPA 授權頁，刻意不列在這裡，維持落到 location /。
    location ~ ^/(\.well-known/oauth-(protected-resource|authorization-server)|oauth/(register|token|revoke)) {
        proxy_pass http://faryne_api;
        proxy_set_header Host faryne.dev;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # SNS 預覽圖卡（1200×630 JPEG）：路徑跟閱讀頁一一對應，例如 /og-image/work/{專案}/story/{id}.jpg，
    # 轉給後端 /sns-image/storyteller/...（補前綴的理由同 @steamloom_sns）。^~ 讓它優先於下面的 regex location，
    # 也不會經過 location / 的爬蟲判斷——平台抓圖用的 UA 跟抓頁面是同一個。
    location ^~ /og-image/ {
        rewrite ^/og-image/(.*)$ /sns-image/storyteller/$1 break;
        proxy_pass http://faryne_api;
        proxy_set_header Host faryne.dev;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # steamloom.works 跟主站共用同一份前端 build，public/ 底下的 robots.txt、sitemap.xml 是 faryne.dev 的，
    # 這兩個改由後端動態產生（sitemap 列出公開作品、故事、設定與作者頁）。
    location = /robots.txt {
        rewrite ^ /sns-seo/steamloom/robots.txt break;
        proxy_pass http://faryne_api;
        proxy_set_header Host faryne.dev;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /sitemap.xml {
        rewrite ^ /sns-seo/steamloom/sitemap.xml break;
        proxy_pass http://faryne_api;
        proxy_set_header Host faryne.dev;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # MCP endpoint for external tools (Codex / Grok Builds 等) 存取 storyteller CRUD。
    # 轉給後端 route.StorytellerMCP 註冊的 /storyteller-mcp（故意不是 /storyteller/mcp，
    # 見 route/storyteller_mcp.go 的註解：那個路徑會被 authsession 的 Use 路由攔截）。
    location /mcp {
        rewrite ^/mcp(.*)$ /storyteller-mcp$1 break;
        proxy_pass http://faryne_api;
        proxy_set_header Host faryne.dev;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        error_page 418 = @steamloom_sns;

        if ($sns_render) {
            return 418;
        }

        proxy_pass https://steamloom-web.web.app;
        proxy_ssl_server_name on;
        proxy_ssl_name steamloom-web.web.app;
        proxy_set_header Host steamloom-web.web.app;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
