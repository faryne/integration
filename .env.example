# 正式環境務必設成 production：會寫入正式外部資源的功能（稽核封存匯出、DMM 影片寫入 ES）只在正式環境執行
APP_ENV="development"
APP_PORT=8080
FRONTEND_PATH=""

# 手動維護開關；有設 MAINTENANCE_START／MAINTENANCE_END 任一個時改用時間區間判斷，MAINTENANCE_MODE 會被忽略
# 時間格式：2006-01-02 15:04（本機時區）
MAINTENANCE_MODE=false
MAINTENANCE_START=
MAINTENANCE_END=

LOCALHOST_DSN=""
WALOLITA_DSN=
WALOLITA_SLAVE_DSN=
NEKOMAID_DSN=

REDIS_DSN=

ES_DSN=

# AMQP 連線字串（目前用 CloudAMQP 代管的 LavinMQ）；留空代表不啟用佇列
# 本機可用 docker-compose 的 lavinmq：amqp://guest:guest@localhost:5672/
AMQP_URL=
# 只給 service/mq 整合測試用；go test 不會讀 .env，要在執行時帶入，留空則略過測試
AMQP_TEST_URL=

NEKOMAID_PIXIV_PASSWORD=
NEKOMAID_PIXIV_USERNAME=
NEKOMAID_TINAMI_APIKEY=
TELEGRAPH_TOKEN=
GROK_API_KEY=

CHROME_PATH=

FIREBASE_PROJECT_ID=""
STORYTELLER_FIREBASE_PROJECT_ID=""

S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"
S3_BUCKET=""

NEKOMAID_BUCKET=""
NEKOMAID_TINAMI_KEY=""
NEKOMAID_S3_KEY=""
NEKOMAID_S3_SECRET=""
CLOUDFRONT_KEY_PAIR_ID=""
CLOUDFRONT_PRIVATE_KEY_FILE=""

STORYTELLER_SEARCH_INDEX=""
# storyteller 圖像頁專用，跟上面共用的 CLOUDFRONT_KEY_PAIR_ID 分開、不共用私鑰
STORYTELLER_CLOUDFRONT_KEY_PAIR_ID=""
STORYTELLER_CLOUDFRONT_PRIVATE_KEY_FILE=""
# 每個使用者最多能鎖定幾則站內通知（鎖定的不會被 180 天保留期清除）
STORYTELLER_NOTIFICATION_LOCK_LIMIT=50
# 站內 AI 助理開關：2026-10-03 起停用（改以 MCP 為主），false 時相關 API 回 403；前端對應 VITE_STORYTELLER_AI_ASSISTANT_ENABLED
STORYTELLER_AI_ASSISTANT_ENABLED=false

PIXIV_USERNAME=""
PIXIV_PASSWORD=""
NICO_EMAIL=""
NICO_PASSWORD=""

CDN_URL=""
# 抓台灣限定網站（台電、消防）用的 Cloudflare Worker proxy；留空表示直連（本機在台灣時）
CF_WORKER_PROXY_URL=""
CF_WORKER_PROXY_SECRET=""

YOUTUBE_API_KEY=""
# VTuber 直播行事曆：service account JSON 路徑（Firebase RTDB 與 Google Calendar 共用）與 RTDB 網址；留空則不同步行事曆
VTUBER_GOOGLE_CREDENTIALS=""
VTUBER_FIREBASE_DATABASE_URL=""
# 一次性：-cmd vtuber-import-calendars 從舊 Firebase 匯入行事曆用，匯入完就可以移除
VTUBER_LEGACY_FIREBASE_SECRET=""

FINMIND_TOKEN=""
DISCORD_WEBHOOK=""
TG_BOT_TOKEN=""
TG_CHAT_ID=""
# 本機與正式環境共用 ES cluster，本機測試 DMM 影片同步時要改成別的 index 名稱
DMM_VIDEO_INDEX="dmmvideos"

# 只給本機開發自動化測試用（免走 Firebase 登入彈窗），開了才會多一條
# POST /auth/dev-session 路由，簽發固定測試帳號的合法 session。
# 千萬不要在 staging／正式環境開這個值。
ENABLE_DEV_AUTH_BYPASS=false

AUDIT_ARCHIVE_BUCKET=
AUDIT_ARCHIVE_PREFIX=
AUDIT_ARCHIVE_REGION=ap-northeast-1
AUDIT_ARCHIVE_RETENTION_YEARS=7
AUDIT_ARCHIVE_MAX_MONTHS=12
AUDIT_ATHENA_WORKGROUP=
AUDIT_ATHENA_DATABASE=
AUDIT_ATHENA_TABLE=
AUDIT_AWS_ACCESS_KEY=
AUDIT_AWS_SECRET_KEY=

