{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@writer/*": ["./src/*"],
      "@steamloom-web/*": ["../../../../static_site/src/*"],
      "@/*": ["../../../../static_site/src/*"],
      // paths 對應不讀套件的 exports：只靠 exports 才有的子路徑要逐一列（CI 沒有 static_site/node_modules 可退回）
      "@tiptap/react/menus": ["./node_modules/@tiptap/react/dist/menus/index.d.ts"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    },
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "wailsjs", "vite.config.ts"]
}
