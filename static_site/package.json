{
  "name": "static_site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm encode-contacts && tsc -b && vite build && node scripts/prerender.mjs",
    "encode-contacts": "node scripts/encode-contact-source.mjs",
    "deploy": "pnpm deploy:main && pnpm deploy:galgame",
    "deploy:main": "firebase deploy --project faryne-integration --only hosting:main",
    "deploy:galgame": "firebase deploy --project galgame-tv --only hosting:galgame",
    "deploy:nekomaid": "firebase target:apply hosting nekomaid nekomaid --project faryne-firebase && firebase deploy --project faryne-firebase --only hosting:nekomaid",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint -c eslint.config.js .",
    "preview": "vite preview",
    "format": "prettier 'src/**/*.{js,ts,jsx,tsx,vue}' --write"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@mui/x-charts": "^8.28.0",
    "@mui/x-date-pickers": "^8.27.2",
    "@tanstack/react-query": "^5.94.5",
    "ace-builds": "^1.43.6",
    "ajv": "^8.18.0",
    "apexcharts": "^5.11.0",
    "axios": "^1.13.6",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dayjs": "^1.11.20",
    "firebase": "^12.14.0",
    "headbreaker": "^3.0.0",
    "jsoneditor": "^10.4.2",
    "jsoneditor-react": "^3.1.2",
    "react": "^19.2.4",
    "react-apexcharts": "^2.1.0",
    "react-chat-elements": "^12.0.18",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-markdown-editor-lite": "^1.4.2",
    "react-router-dom": "^7.13.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1"
  }
}
