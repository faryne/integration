{
  "name": "static_site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm encode-contacts && tsc -b && vite build && node scripts/prerender.mjs",
    "encode-contacts": "node scripts/encode-contact-source.mjs",
    "deploy": "pnpm deploy:main && pnpm deploy:galgame",
    "deploy:main": "firebase deploy --project faryne-integration --only hosting:main",
    "deploy:galgame": "firebase deploy --project galgame-tv --only hosting:galgame",
    "deploy:nekomaid": "firebase target:apply hosting nekomaid nekomaid --project faryne-firebase && firebase deploy --project faryne-firebase --only hosting:nekomaid",
    "deploy:steamloom": "firebase target:apply hosting steamloom steamloom-web --project steamloom && firebase deploy --project steamloom --only hosting:steamloom",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint -c eslint.config.js .",
    "test": "vitest run",
    "preview": "vite preview",
    "format": "prettier 'src/**/*.{js,ts,jsx,tsx,vue}' --write"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-charts": "^8.29.2",
    "@mui/x-chat": "9.0.0-alpha.10",
    "@mui/x-date-pickers": "^8.29.2",
    "@tanstack/react-query": "^5.101.2",
    "@tiptap/core": "^3.27.3",
    "@tiptap/extension-bold": "^3.27.3",
    "@tiptap/extension-document": "^3.27.3",
    "@tiptap/extension-dropcursor": "^3.27.3",
    "@tiptap/extension-gapcursor": "^3.27.3",
    "@tiptap/extension-history": "^3.27.3",
    "@tiptap/extension-italic": "^3.27.3",
    "@tiptap/extension-paragraph": "^3.27.3",
    "@tiptap/extension-strike": "3.27.3",
    "@tiptap/extension-subscript": "^3.27.3",
    "@tiptap/extension-superscript": "^3.27.3",
    "@tiptap/extension-text": "^3.27.3",
    "@tiptap/extension-text-align": "^3.27.3",
    "@tiptap/extension-underline": "^3.27.3",
    "@tiptap/pm": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/suggestion": "3.27.3",
    "ace-builds": "^1.44.0",
    "ajv": "^8.20.0",
    "apexcharts": "^5.16.0",
    "axios": "^1.18.1",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dayjs": "^1.11.21",
    "firebase": "^12.15.0",
    "headbreaker": "^3.0.0",
    "jsoneditor": "^10.4.3",
    "jsoneditor-react": "^3.1.2",
    "react": "^19.2.7",
    "react-apexcharts": "^2.1.1",
    "react-chat-elements": "^12.0.18",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-markdown-editor-lite": "^1.4.2",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
